# =========================================================
# Xiaomi AX3000T V1 · LEDE (coolsnowwolf/lede) 正式版 — passwall 版
# ---------------------------------------------------------
# 源码：coolsnowwolf/lede master（不锁版本，每次拉最新）
# 设备：xiaomi_mi-router-ax3000t（原生大分区，单一 UBI 112MB）
# 内核：pin 6.12（源码默认 6.18，workflow 里改 Makefile）
# 插件（基于已成功的 passwall 版，主人 2026-11-27 二修订：去 frpc/vlmcsd，加 ttyd，修 BBR 开机自启）：
#   ① Argon 主题  ② passwall（内核仅 sing-box/geoview/chinadns-ng）
#   ③ BBR(kmod 单独 + procd init START=98 开机先 modprobe 再设 bbr,根治开机没加载)
#   ④ autoreboot(定时重启)  ⑤ ttyd(网页终端,官方包 luci-app-ttyd)
# 不编：homeproxy / filetransfer / mosdns / frpc / vlmcsd / turboacc / xray /
#       smartdns / ss/ssr 全家 / hysteria / naiveproxy / ipv6helper
# IPv6：系统默认组件自带，不加 ipv6helper
# =========================================================

# ----- 目标设备（lede 原生大分区，单 UBI）-----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_xiaomi_mi-router-ax3000t=y

# ----- LuCI 基础界面 + 中文 -----
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# ----- ① passwall 26.11.23（feed: passwall_luci + passwall_packages）-----
CONFIG_PACKAGE_luci-app-passwall=y
# 透明代理：nftables 模式（firewall4 环境），自动带 kmod-nft-socket/tproxy/nat
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_firewall4=y
# 显式兜底 nft 内核模块（passwall 硬依赖，defconfig 也应带上）
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
# 内核裁剪：只留 sing-box + geoview（chinadns-ng 是 LUCI_DEPENDS 硬依赖，自动带入）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_chinadns-ng=y
# 其余代理内核一律不编
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# passwall 硬依赖的小工具（curl 等）由 LUCI_DEPENDS 自动带入，不要在这里 not set

# ----- ② Argon 主题（含设置页）-----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ----- ③ BBR：kmod-tcp-bbr（开机由 workflow 注入的 procd init START=98 加载并启用）-----
CONFIG_PACKAGE_kmod-tcp-bbr=y
# 注：lede master 无独立 kmod-sched-fq 包（fq 队列已在 6.12 内核内置），不要勾
# 明确不要 turboacc（含 offloading/Shortcut-FE，会和 nftables 透明代理冲突）
# CONFIG_PACKAGE_luci-app-turboacc is not set

# ----- ④ autoreboot（定时重启；中文由全局 zh_Hans 自动带入）-----
CONFIG_PACKAGE_luci-app-autoreboot=y

# ----- ⑤ ttyd（网页版命令行终端；官方包，依赖 ttyd 自动带入）-----
CONFIG_PACKAGE_luci-app-ttyd=y

# ----- ⑥ 新增 6 件套（主人 2026-11-27 三修订，编进固件）-----
# DDNSTO 远程控制（官方 linkease feed：ddnsto 二进制 + luci 界面）
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y
# 动态 DNS（ddns-scripts-services 是服务商脚本；aliyun/dnspod 国内常用，一并带上）
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_ddns-scripts_dnspod=y
# UPnP（用 nftables 变体；iptables 变体会拉旧版 iptables 栈进 fw4 系统，不要）
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
# IP/MAC 绑定
CONFIG_PACKAGE_luci-app-arpbind=y
# IP 限速（lede lean 包）
CONFIG_PACKAGE_luci-app-eqos=y
# 负载均衡
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_mwan3=y

# ----- 明确不编的插件（防依赖/默认值拉回）-----
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set
# CONFIG_PACKAGE_mosdns is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn is not set
# 主人 2026-11-27 二修订：vlmcsd 不编，显式 not set 防拉回
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# 主人 2026-11-27 拍板：第三方源项目终止，frpc 彻底不编
# CONFIG_PACKAGE_frpc is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-i18n-frpc-zh-cn is not set
# CONFIG_PACKAGE_frps is not set
# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_firewall is not set
# CONFIG_PACKAGE_smartdns is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_xray-plugin is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# helloworld/ssr-plus 的内核（default y if aarch64 会被 defconfig 自动打开，
# workflow 已用 sed 改成 default n；这里再显式 not set 做双保险）
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server is not set
# CONFIG_PACKAGE_v2ray-geoip is not set
# CONFIG_PACKAGE_v2ray-geosite is not set

# ----- 摘除 passwall 两条 404 坏源（编译源头解决，出厂固件就不带）-----
# distfeeds.conf 由 include/feeds.mk 的 FeedSourcesAppendOPKG 生成：
# CONFIG_FEED_<feed>=m → 生成 "# src/gz ..."（注释行），opkg update 不再 404。
# 设为 m 只影响软件源列表，不影响 passwall 包编译（编译由 CONFIG_PACKAGE_* 控制）。
CONFIG_FEED_passwall_packages=m
CONFIG_FEED_passwall_luci=m

# ----- 纯净度：luci 元包会连带拉入的非必需 app，显式剔除 -----
# （ddns/upnp/arpbind 三件 2026-11-27 三修订起编进固件，已从本段移除）
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-oui is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set
# CONFIG_PACKAGE_luci-app-rclone is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_vsftpd is not set
# CONFIG_PACKAGE_etherwake is not set
# CONFIG_PACKAGE_htop is not set
# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_luci-theme-design is not set
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_ip6tables is not set
# CONFIG_PACKAGE_iptables-mod-extra is not set
# CONFIG_PACKAGE_iptables-mod-tproxy is not set
# CONFIG_PACKAGE_ipset is not set
